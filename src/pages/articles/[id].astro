---
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const showDrafts = import.meta.env.DEV;

  const articles = await getCollection(
    'articles',
    ({ data }) => {
      return showDrafts || data.draft !== true;
    },
  );

  return articles.map((article) => ({
    params: {
      id: article.id,
    },
    props: {
      article,
    },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
>
  <article class="page-container article-page">
    <header class="article-header">
      <p class="eyebrow">{article.data.category}</p>

      <h1 class="page-title">
        {article.data.title}
      </h1>

      <p class="page-description">
        {article.data.description}
      </p>

      <div class="article-meta article-page-meta">
        <time datetime={article.data.publishDate.toISOString()}>
          发布于 {formatDate(article.data.publishDate)}
        </time>

        {
          article.data.updatedDate && (
            <span>
              更新于 {formatDate(article.data.updatedDate)}
            </span>
          )
        }

        {
          article.data.draft && (
            <span class="draft-label">草稿预览</span>
          )
        }
      </div>

      {
        article.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="文章标签">
            {
              article.data.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))
            }
          </ul>
        )
      }
    </header>

    <div class="article-content">
      <Content />
    </div>

    <footer class="article-footer">
      <a class="text-link" href="/articles">
        ← 返回文章列表
      </a>
    </footer>
  </article>
</BaseLayout>
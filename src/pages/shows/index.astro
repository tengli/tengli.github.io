---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="节目"
  description="Teng Li 的音频和视频节目。"
>
  <div class="page-container">
    <p class="eyebrow">Shows</p>
    <h1 class="page-title">节目</h1>

    <p class="page-description">
      这里将集中展示音频播客、视频节目。
    </p>

    <section class="section">
      <article class="card">
        <p class="card-type">筹备中</p>
        <h3>社会文化观察节目</h3>
        <p>
          讨论公共文化、知识传播、观念与社会生活之间的关系。
        </p>
      </article>
    </section>
  </div>
</BaseLayout>
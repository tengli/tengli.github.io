---
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const shows = await getCollection(
    'shows',
    ({ data }) => data.draft !== true,
  );

  return shows.map((show) => ({
    params: {
      id: show.id,
    },

    props: {
      show,
    },
  }));
}

interface Props {
  show: CollectionEntry<'shows'>;
}

const { show } = Astro.props;
const { Content } = await render(show);
---

<BaseLayout
  title={show.data.title}
  description={show.data.description}
>
  <article class="page-container detail-page">
    <header class="detail-header">
      <p class="eyebrow">
        {show.data.showType} · {show.data.platform}
      </p>

      <h1 class="page-title">
        {show.data.title}
      </h1>

      <p class="page-description">
        {show.data.description}
      </p>

      <div class="detail-meta">
        <time datetime={show.data.publishDate.toISOString()}>
          发布于 {formatDate(show.data.publishDate)}
        </time>

        {
          show.data.episodeNumber && (
            <span>第 {show.data.episodeNumber} 期</span>
          )
        }

        {
          show.data.duration && (
            <span>{show.data.duration}</span>
          )
        }
      </div>
    </header>

    {
      show.data.embedUrl && (
        <div class="show-player">
          <iframe
            src={show.data.embedUrl}
            title={show.data.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          >
          </iframe>
        </div>
      )
    }

    {
      show.data.externalUrl && (
        <div class="detail-actions">
          <a
            class="button button-primary"
            href={show.data.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            前往节目平台
          </a>
        </div>
      )
    }

    <div class="article-content">
      <Content />
    </div>

    <footer class="article-footer">
      <a class="text-link" href="/shows">
        ← 返回节目列表
      </a>
    </footer>
  </article>
</BaseLayout>
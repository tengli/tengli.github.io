---
import { getCollection, type CollectionEntry } from 'astro:content';

import ShowDetailPage from '../../../components/pages/ShowDetailPage.astro';
import { contentPath, contentSlug } from '../../../i18n/config';

export async function getStaticPaths() {
  const showDrafts = import.meta.env.DEV;
  const allShows = await getCollection(
    'shows',
    ({ data }) => showDrafts || data.draft !== true,
  );

  return allShows
    .filter(({ data }) => data.locale === 'zh')
    .map((show) => {
      const slug = contentSlug(show.id);
      const translation = allShows.find(
        (entry) => entry.data.locale === 'en' && contentSlug(entry.id) === slug,
      );

      return {
        params: { id: slug },
        props: {
          show,
          alternateHref: translation ? contentPath('shows', translation.id, 'en') : null,
        },
      };
    });
}

interface Props {
  show: CollectionEntry<'shows'>;
  alternateHref: string | null;
}

const { show, alternateHref } = Astro.props;
---

<ShowDetailPage show={show} locale="zh" alternateHref={alternateHref} />

---
import { getCollection, type CollectionEntry } from 'astro:content';

import ProjectDetailPage from '../../../components/pages/ProjectDetailPage.astro';
import { contentPath, contentSlug } from '../../../i18n/config';

export async function getStaticPaths() {
  const showDrafts = import.meta.env.DEV;
  const allProjects = await getCollection(
    'projects',
    ({ data }) => showDrafts || data.draft !== true,
  );

  return allProjects
    .filter(({ data }) => data.locale === 'zh')
    .map((project) => {
      const slug = contentSlug(project.id);
      const translation = allProjects.find(
        (entry) => entry.data.locale === 'en' && contentSlug(entry.id) === slug,
      );

      return {
        params: { id: slug },
        props: {
          project,
          alternateHref: translation
            ? contentPath('projects', translation.id, 'en')
            : null,
        },
      };
    });
}

interface Props {
  project: CollectionEntry<'projects'>;
  alternateHref: string | null;
}

const { project, alternateHref } = Astro.props;
---

<ProjectDetailPage project={project} locale="zh" alternateHref={alternateHref} />

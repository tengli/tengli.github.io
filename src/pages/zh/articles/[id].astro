---
import { getCollection, type CollectionEntry } from 'astro:content';

import ArticleDetailPage from '../../../components/pages/ArticleDetailPage.astro';
import { contentPath, contentSlug } from '../../../i18n/config';

export async function getStaticPaths() {
  const showDrafts = import.meta.env.DEV;
  const allArticles = await getCollection(
    'articles',
    ({ data }) => showDrafts || data.draft !== true,
  );

  return allArticles
    .filter(({ data }) => data.locale === 'zh')
    .map((article) => {
      const slug = contentSlug(article.id);
      const translation = allArticles.find(
        (entry) => entry.data.locale === 'en' && contentSlug(entry.id) === slug,
      );

      return {
        params: { id: slug },
        props: {
          article,
          alternateHref: translation
            ? contentPath('articles', translation.id, 'en')
            : null,
        },
      };
    });
}

interface Props {
  article: CollectionEntry<'articles'>;
  alternateHref: string | null;
}

const { article, alternateHref } = Astro.props;
---

<ArticleDetailPage article={article} locale="zh" alternateHref={alternateHref} />

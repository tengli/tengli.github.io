---
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/formatDate';

export async function getStaticPaths() {
  const projects = await getCollection(
    'projects',
    ({ data }) => data.draft !== true,
  );

  return projects.map((project) => ({
    params: {
      id: project.id,
    },

    props: {
      project,
    },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
>
  <article class="page-container detail-page">
    <header class="detail-header">
      <p class="eyebrow">
        {project.data.status}
      </p>

      <h1 class="page-title">
        {project.data.title}
      </h1>

      <p class="page-description">
        {project.data.description}
      </p>

      <div class="detail-meta">
        <span>
          开始于 {formatDate(project.data.startDate)}
        </span>

        {
          project.data.updatedDate && (
            <span>
              更新于 {formatDate(project.data.updatedDate)}
            </span>
          )
        }
      </div>

      {
        project.data.techStack.length > 0 && (
          <ul class="tag-list" aria-label="技术栈">
            {
              project.data.techStack.map((technology) => (
                <li class="tag">{technology}</li>
              ))
            }
          </ul>
        )
      }

      <div class="detail-actions">
        {
          project.data.demoUrl && (
            <a
              class="button button-primary"
              href={project.data.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              查看网站
            </a>
          )
        }

        {
          project.data.repositoryUrl && (
            <a
              class="button button-secondary"
              href={project.data.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              查看 GitHub
            </a>
          )
        }
      </div>
    </header>

    <div class="article-content">
      <Content />
    </div>

    <footer class="article-footer">
      <a class="text-link" href="/projects">
        ← 返回项目列表
      </a>
    </footer>
  </article>
</BaseLayout>
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="项目"
  description="Teng Li 的 AI 应用和个人开发项目。"
>
  <div class="page-container">
    <p class="eyebrow">Projects</p>
    <h1 class="page-title">项目</h1>

    <p class="page-description">
      展示正在学习、开发和持续迭代的技术项目。
    </p>

    <section class="section">
      <div class="card-grid">
        <article class="card">
          <p class="card-type">开发中</p>
          <h3>个人内容网站</h3>
          <p>
            使用 Astro、GitHub Pages 和 Markdown 搭建的个人网站。
          </p>
        </article>

        <article class="card">
          <p class="card-type">学习项目</p>
          <h3>AI 应用开发练习</h3>
          <p>
            使用 Python 和 FastAPI 构建的数据处理与 AI 应用项目。
          </p>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
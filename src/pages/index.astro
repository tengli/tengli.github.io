---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContentCard from '../components/ContentCard.astro';

const articleCards = [
  {
    type: '学习与开发',
    title: '我为什么开始学习 AI 应用开发',
    description:
      '从产品经理转向 AI 应用开发的背景、目标与阶段性学习路线。',
    href: '/articles',
    tags: ['AI', '编程学习', '职业转型'],
  },
  {
    type: '社会与文化',
    title: '文化中介在公共讨论中扮演什么角色',
    description:
      '从知识生产、传播机制与公共表达重新理解文化中介。',
    href: '/articles',
    tags: ['文化观察', '公共讨论'],
  },
  {
    type: '澳洲生活',
    title: '从互联网产品经理到布里斯班',
    description:
      '一次职业、城市和生活方式同时发生变化的阶段性记录。',
    href: '/articles',
    tags: ['布里斯班', '个人记录'],
  },
];

const projectCards = [
  {
    type: '开发项目',
    title: '个人内容网站',
    description:
      '使用 Astro、Markdown、GitHub 和 GitHub Pages 搭建个人网站。',
    href: '/projects',
    meta: '开发中',
    tags: ['Astro', 'GitHub'],
  },
  {
    type: 'AI 学习项目',
    title: '订单数据分析与 API',
    description:
      '使用 Python、测试和 FastAPI 逐步构建数据处理服务。',
    href: '/projects',
    meta: '学习中',
    tags: ['Python', 'FastAPI'],
  },
];

const showCards = [
  {
    type: '音频节目',
    title: '社会文化观察',
    description:
      '讨论文化现象、公共议题和观念如何参与现实生活。',
    href: '/shows',
    meta: '筹备中',
    tags: ['文化', '社会'],
  },
];
---

<BaseLayout
  title="首页"
  description="Teng Li 的个人网站，记录 AI 应用开发、产品、社会文化、历史与澳洲生活。"
>
  <div class="page-container">
    <section class="hero">
      <p class="eyebrow">Product · AI · Culture</p>

      <h1>
        在技术、产品与人文之间，
        建立自己的长期作品。
      </h1>

      <p class="hero-description">
        我是 Teng Li，曾长期从事互联网产品工作，现居布里斯班。
        目前正在学习 AI 应用开发，并持续写作科技、历史、
        城市与社会文化相关内容。
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="/articles">
          阅读文章
        </a>

        <a class="button button-secondary" href="/about">
          了解我
        </a>
      </div>
    </section>

    <section class="section">
      <SectionHeading
        title="最新文章"
        description="关于技术学习、文化观察和个人转型的记录。"
        href="/articles"
        linkLabel="全部文章"
      />

      <div class="card-grid">
        {
          articleCards.map((card) => (
            <ContentCard
              type={card.type}
              title={card.title}
              description={card.description}
              href={card.href}
              tags={card.tags}
              linkLabel="查看文章"
            />
          ))
        }
      </div>
    </section>

    <section class="section">
      <SectionHeading
        title="正在开发"
        description="将学习过程转化为可以展示和持续迭代的项目。"
        href="/projects"
        linkLabel="全部项目"
      />

      <div class="card-grid">
        {
          projectCards.map((card) => (
            <ContentCard
              type={card.type}
              title={card.title}
              description={card.description}
              href={card.href}
              meta={card.meta}
              tags={card.tags}
              linkLabel="查看项目"
            />
          ))
        }
      </div>
    </section>

    <section class="section">
      <SectionHeading
        title="节目"
        description="围绕社会文化与公共议题展开的音频和视频内容。"
        href="/shows"
        linkLabel="全部节目"
      />

      <div class="card-grid">
        {
          showCards.map((card) => (
            <ContentCard
              type={card.type}
              title={card.title}
              description={card.description}
              href={card.href}
              meta={card.meta}
              tags={card.tags}
              linkLabel="查看节目"
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
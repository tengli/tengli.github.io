---
interface Props {
  type: string;
  title: string;
  description: string;
  href: string;
  linkLabel?: string;
  meta?: string;
  tags?: string[];
}

const {
  type,
  title,
  description,
  href,
  linkLabel = '查看详情',
  meta,
  tags = [],
} = Astro.props;
---

<article class="card content-card">
  <p class="card-type">{type}</p>

  {meta && <p class="card-meta">{meta}</p>}

  <h3><a class="card-title" href={href}>{title}</a></h3>

  <p class="card-description">{description}</p>

  {
    tags.length > 0 && (
      <ul class="tag-list" aria-label="标签">
        {
          tags.map((tag) => (
            <li class="tag">{tag}</li>
          ))
        }
      </ul>
    )
  }

  <footer class="card-footer">
    <a class="text-link" href={href}>
      {linkLabel} <span aria-hidden="true">↗</span>
    </a>
  </footer>
</article>

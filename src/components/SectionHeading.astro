---
interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const {
  title,
  description,
  href,
  linkLabel = '查看全部',
} = Astro.props;
---

<div class="section-heading-row">
  <div class="section-heading">
    <h2>{title}</h2>

    {
      description && (
        <p>{description}</p>
      )
    }
  </div>

  {
    href && (
      <a class="text-link" href={href}>
        {linkLabel} →
      </a>
    )
  }
</div>
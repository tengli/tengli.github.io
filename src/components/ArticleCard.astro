---
import type { CollectionEntry } from 'astro:content';
import {
  contentPath,
  ui,
  type Locale,
} from '../i18n/config';
import { formatDate } from '../utils/formatDate';

interface Props {
  article: CollectionEntry<'articles'>;
  locale: Locale;
}

const { article, locale } = Astro.props;
const copy = ui[locale];

const {
  title,
  description,
  publishDate,
  category,
  tags,
  draft,
} = article.data;

const articleUrl = contentPath('articles', article.id, locale);
---

<article class="card article-card">
  <div class="card-meta-row article-meta">
    <span class="article-category">{copy.articleCategories[category]}</span>

    <time datetime={publishDate.toISOString()}>
      {formatDate(publishDate, locale)}
    </time>

    {draft && <span class="draft-label">{copy.articles.draft}</span>}
  </div>

  <h3>
    <a class="card-title" href={articleUrl}>
      {title}
    </a>
  </h3>

  <p class="card-description">{description}</p>

  <footer class="card-footer">
    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label={copy.articles.tagsLabel}>
          {
            tags.slice(0, 3).map((tag) => (
              <li class="tag">{tag}</li>
            ))
          }
        </ul>
      )
    }

    <a
      class="text-link"
      href={articleUrl}
      aria-label={`${copy.articles.read}: ${title}`}
    >
      {copy.articles.read} <span aria-hidden="true">↗</span>
    </a>
  </footer>
</article>

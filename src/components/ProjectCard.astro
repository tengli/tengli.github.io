---
import type { CollectionEntry } from 'astro:content';
import {
  contentPath,
  ui,
  type Locale,
} from '../i18n/config';
import { formatDate } from '../utils/formatDate';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const copy = ui[locale];

const {
  title,
  description,
  startDate,
  status,
  techStack,
} = project.data;

const projectUrl = contentPath('projects', project.id, locale);
---

<article class="card project-card">
  <div class="card-meta-row">
    <span class="status-label">{copy.projectStatuses[status]}</span>
    <span>{copy.projects.startedOn} {formatDate(startDate, locale)}</span>
  </div>

  <h3>
    <a href={projectUrl}>{title}</a>
  </h3>

  <p>{description}</p>

  {
    techStack.length > 0 && (
      <ul class="tag-list" aria-label={copy.projects.techLabel}>
        {
          techStack.slice(0, 5).map((technology) => (
            <li class="tag">{technology}</li>
          ))
        }
      </ul>
    )
  }

  <a class="text-link" href={projectUrl}>
    {copy.projects.view} →
  </a>
</article>

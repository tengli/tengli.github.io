---
import { localizedPath, ui, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentYear = new Date().getFullYear();
const copy = ui[locale];
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>© {currentYear} Teng Li</p>

    <div class="footer-links">
      <a href={localizedPath(locale, '/about')}>{copy.footerAbout}</a>
      <a href="https://github.com/tengli">
        GitHub
      </a>
    </div>
  </div>
</footer>

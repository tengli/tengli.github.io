---
import { getCollection } from 'astro:content';

import ArticleCard from '../ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale].articles;
const showDrafts = import.meta.env.DEV;

const articles = (
  await getCollection('articles', ({ data }) =>
    data.locale === locale && (showDrafts || data.draft !== true),
  )
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout locale={locale} title={copy.pageTitle} description={copy.description}>
  <div class="page-container">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 class="page-title">{copy.pageTitle}</h1>
    <p class="page-description">{copy.introduction}</p>

    <section class="section">
      {
        articles.length > 0 ? (
          <div class="card-grid">
            {articles.map((article) => (
              <ArticleCard article={article} locale={locale} />
            ))}
          </div>
        ) : (
          <p>{copy.empty}</p>
        )
      }
    </section>
  </div>
</BaseLayout>

---
import { getCollection } from 'astro:content';

import ArticleCard from '../ArticleCard.astro';
import ProjectCard from '../ProjectCard.astro';
import SectionHeading from '../SectionHeading.astro';
import ShowCard from '../ShowCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizedPath, ui, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale].home;

const latestArticles = (
  await getCollection('articles', ({ data }) =>
    data.locale === locale && data.draft !== true,
  )
)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const featuredShows = (
  await getCollection('shows', ({ data }) =>
    data.locale === locale && data.draft !== true && data.featured === true,
  )
)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const featuredProjects = (
  await getCollection('projects', ({ data }) =>
    data.locale === locale && data.draft !== true && data.featured === true,
  )
)
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf())
  .slice(0, 3);
---

<BaseLayout locale={locale} title={copy.pageTitle} description={copy.description}>
  <div class="page-container">
    <section class="hero home-hero">
      <div class="hero-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.headline}</h1>
        <p class="hero-description">{copy.introduction}</p>

        <div class="hero-actions">
          <a class="button button-primary" href={localizedPath(locale, '/projects')}>
            {copy.primaryAction}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button button-secondary" href={localizedPath(locale, '/about')}>
            {copy.secondaryAction}
          </a>
        </div>
      </div>

      <aside class="hero-note" aria-label={copy.currentLabel}>
        <div class="hero-note-index" aria-hidden="true">TL / 01</div>
        <p class="hero-note-label">{copy.currentLabel}</p>
        <h2>{copy.currentTitle}</h2>
        <p>{copy.currentDescription}</p>
        <dl class="hero-focus">
          <dt>{copy.focusLabel}</dt>
          <dd>{copy.focusValue}</dd>
        </dl>
      </aside>
    </section>

    <section class="section home-section">
      <SectionHeading
        kicker={copy.articlesKicker}
        title={copy.articlesTitle}
        description={copy.articlesDescription}
        href={localizedPath(locale, '/articles')}
        linkLabel={copy.articlesLink}
      />
      {
        latestArticles.length > 0 ? (
          <div class="card-grid">
            {latestArticles.map((article) => (
              <ArticleCard article={article} locale={locale} />
            ))}
          </div>
        ) : (
          <p>{copy.noArticles}</p>
        )
      }
    </section>

    <section class="section home-section">
      <SectionHeading
        kicker={copy.projectsKicker}
        title={copy.projectsTitle}
        description={copy.projectsDescription}
        href={localizedPath(locale, '/projects')}
        linkLabel={copy.projectsLink}
      />
      {
        featuredProjects.length > 0 ? (
          <div class="card-grid">
            {featuredProjects.map((project) => (
              <ProjectCard project={project} locale={locale} />
            ))}
          </div>
        ) : (
          <p>{copy.noProjects}</p>
        )
      }
    </section>

    <section class="section home-section">
      <SectionHeading
        kicker={copy.showsKicker}
        title={copy.showsTitle}
        description={copy.showsDescription}
        href={localizedPath(locale, '/shows')}
        linkLabel={copy.showsLink}
      />
      {
        featuredShows.length > 0 ? (
          <div class="card-grid">
            {featuredShows.map((show) => (
              <ShowCard show={show} locale={locale} />
            ))}
          </div>
        ) : (
          <p>{copy.noShows}</p>
        )
      }
    </section>
  </div>
</BaseLayout>

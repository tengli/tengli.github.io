---
import { getCollection } from 'astro:content';

import ShowCard from '../ShowCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale].shows;
const showDrafts = import.meta.env.DEV;

const shows = (
  await getCollection('shows', ({ data }) =>
    data.locale === locale && (showDrafts || data.draft !== true),
  )
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout locale={locale} title={copy.pageTitle} description={copy.description}>
  <div class="page-container">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 class="page-title">{copy.pageTitle}</h1>
    <p class="page-description">{copy.introduction}</p>

    <section class="section">
      {
        shows.length > 0 ? (
          <div class="card-grid">
            {shows.map((show) => <ShowCard show={show} locale={locale} />)}
          </div>
        ) : (
          <p>{copy.empty}</p>
        )
      }
    </section>
  </div>
</BaseLayout>

---
import { render, type CollectionEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizedPath, ui, type Locale } from '../../i18n/config';
import { formatDate } from '../../utils/formatDate';

interface Props {
  article: CollectionEntry<'articles'>;
  locale: Locale;
  alternateHref: string | null;
}

const { article, locale, alternateHref } = Astro.props;
const { Content } = await render(article);
const copy = ui[locale];
const languageSwitchHref = alternateHref ?? localizedPath(locale === 'en' ? 'zh' : 'en', '/articles');
---

<BaseLayout
  locale={locale}
  title={article.data.title}
  description={article.data.description}
  languageSwitchHref={languageSwitchHref}
  alternateHref={alternateHref}
>
  <article class="page-container article-page">
    <a class="detail-back-link" href={localizedPath(locale, '/articles')}>
      <span aria-hidden="true">←</span> {copy.articles.back}
    </a>

    <header class="article-header">
      <p class="eyebrow">{copy.articleCategories[article.data.category]}</p>
      <h1 class="page-title">{article.data.title}</h1>
      <p class="page-description">{article.data.description}</p>

      <div class="article-meta article-page-meta">
        <time datetime={article.data.publishDate.toISOString()}>
          {copy.articles.publishedOn} {formatDate(article.data.publishDate, locale)}
        </time>
        {
          article.data.updatedDate && (
            <span>
              {copy.articles.updatedOn} {formatDate(article.data.updatedDate, locale)}
            </span>
          )
        }
        {article.data.draft && <span class="draft-label">{copy.articles.draftPreview}</span>}
      </div>

    </header>

    <div class="article-layout">
      <aside class="article-rail">
        <p class="article-rail-label">{copy.articleCategories[article.data.category]}</p>
        {
          article.data.tags.length > 0 && (
            <ul class="tag-list" aria-label={copy.articles.tagsLabel}>
              {article.data.tags.map((tag) => <li class="tag">{tag}</li>)}
            </ul>
          )
        }
      </aside>

      <div class="article-content"><Content /></div>
    </div>

    <footer class="article-footer">
      <a class="button button-secondary" href={localizedPath(locale, '/articles')}>
        <span aria-hidden="true">←</span> {copy.articles.back}
      </a>
    </footer>
  </article>
</BaseLayout>

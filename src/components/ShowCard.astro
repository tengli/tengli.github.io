---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/formatDate';

interface Props {
  show: CollectionEntry<'shows'>;
}

const { show } = Astro.props;

const {
  title,
  description,
  publishDate,
  showType,
  platform,
  episodeNumber,
  duration,
  tags,
} = show.data;

const showUrl = `/shows/${show.id}/`;
---

<article class="card show-card">
  <div class="card-meta-row">
    <span class="card-label">{showType}</span>

    <time datetime={publishDate.toISOString()}>
      {formatDate(publishDate)}
    </time>
  </div>

  <h3>
    <a href={showUrl}>{title}</a>
  </h3>

  <p>{description}</p>

  <div class="show-details">
    <span>{platform}</span>

    {
      episodeNumber && (
        <span>第 {episodeNumber} 期</span>
      )
    }

    {
      duration && (
        <span>{duration}</span>
      )
    }
  </div>

  {
    tags.length > 0 && (
      <ul class="tag-list" aria-label="节目标签">
        {
          tags.slice(0, 3).map((tag) => (
            <li class="tag">{tag}</li>
          ))
        }
      </ul>
    )
  }

  <a class="text-link" href={showUrl}>
    查看节目 →
  </a>
</article>
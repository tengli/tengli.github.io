---
import type { CollectionEntry } from 'astro:content';
import {
  contentPath,
  ui,
  type Locale,
} from '../i18n/config';
import { formatDate } from '../utils/formatDate';

interface Props {
  show: CollectionEntry<'shows'>;
  locale: Locale;
}

const { show, locale } = Astro.props;
const copy = ui[locale];

const {
  title,
  description,
  publishDate,
  showType,
  platform,
  episodeNumber,
  duration,
  tags,
} = show.data;

const showUrl = contentPath('shows', show.id, locale);
---

<article class="card show-card">
  <div class="card-meta-row">
    <span class="card-label">{copy.showTypes[showType]}</span>

    <time datetime={publishDate.toISOString()}>
      {formatDate(publishDate, locale)}
    </time>
  </div>

  <h3>
    <a class="card-title" href={showUrl}>{title}</a>
  </h3>

  <p class="card-description">{description}</p>

  <div class="show-details">
    <span>{platform}</span>

    {
      episodeNumber && (
        <span>
          {copy.shows.episode.replace('{number}', String(episodeNumber))}
        </span>
      )
    }

    {
      duration && (
        <span>{duration}</span>
      )
    }
  </div>

  <footer class="card-footer">
    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label={copy.shows.tagsLabel}>
          {
            tags.slice(0, 3).map((tag) => (
              <li class="tag">{tag}</li>
            ))
          }
        </ul>
      )
    }

    <a class="text-link" href={showUrl}>
      {copy.shows.view} <span aria-hidden="true">↗</span>
    </a>
  </footer>
</article>
